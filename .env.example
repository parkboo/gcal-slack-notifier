# Slack incoming webhook URL. The webhook is bound to a channel, so the
# destination channel is chosen when you create the webhook.
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Calendars to watch, comma separated. Find the id under
# Google Calendar > Settings > <calendar> > Integrate calendar > Calendar ID.
# Each calendar must be shared with the service account email.
CALENDAR_IDS=team@group.calendar.google.com,holidays@group.calendar.google.com

# Path to the Google service account JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=service_account_credentials.json

# Where to keep local state (sync tokens and seen events)
DB_PATH=calendar.sqlite3

# IANA timezone used for formatting and for deciding "today"
TIMEZONE=Asia/Seoul

# Message language: en or ko
LANGUAGE=en

# Minutes before an event starts to send a reminder
REMINDER_MINUTES=15

# Hour of day (0-23, local time) to announce all-day events
ALLDAY_NOTIFY_HOUR=9
