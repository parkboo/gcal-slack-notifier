# cron's default PATH is /usr/bin:/bin, which does not include the python
# installed by the python:slim image at /usr/local/bin.
PATH=/usr/local/bin:/usr/bin:/bin
SHELL=/bin/sh

# Detect new/changed/cancelled events and send reminders
* * * * * cd /app && python calendar_bot.py >> /proc/1/fd/1 2>&1
# Post today's schedule as a single digest.
0 9 * * * cd /app && python calendar_bot.py --daily_digest >> /proc/1/fd/1 2>&1
